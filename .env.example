# =============================================================================
# Root .env.example — committed to Git as a template.
# Copy this file to .env and fill in real values before running Docker.
# All Laravel app secrets (JWT, Stripe, etc.) live in backend/.env
# =============================================================================

# PostgreSQL — must match DB_* values in backend/.env
POSTGRES_USER=tshirtslab
POSTGRES_PASSWORD=change_me
POSTGRES_DB=tshirtslab_db

# Grafana
GF_ADMIN_PASSWORD=change_me
