#!/bin/sh

set -e

# Auto-format only staged backend PHP files with Laravel Pint.
STAGED_BACKEND_PHP=$(git diff --cached --name-only --diff-filter=ACMR | grep '^backend/.*\.php$' || true)

if [ -z "$STAGED_BACKEND_PHP" ]; then
    exit 0
fi

echo "Running Laravel Pint on staged backend PHP files..."

RELATIVE_PHP_FILES=$(printf '%s\n' "$STAGED_BACKEND_PHP" | sed 's#^backend/##')

(
    cd backend
    printf '%s\n' "$RELATIVE_PHP_FILES" | xargs vendor/bin/pint
)

# Re-stage files changed by Pint.
printf '%s\n' "$STAGED_BACKEND_PHP" | xargs git add

echo "✅ Pint auto-formatted staged PHP files."
